@model IEnumerable<FishProduct>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Fish Products";

    var categories = (IEnumerable<SelectListItem>)ViewBag.Categories!;
    var search = ViewBag.Search as string;
    var selectedCategory = ViewBag.CategoryId as int?;
}

<div class="fish-page-header mb-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 position-relative">
        <div>
            <h1>Fish Products</h1>
            <p>Browse and manage every fish in the shop catalogue.</p>
        </div>
        <a asp-controller="FishProducts" asp-action="Create" class="btn btn-fish-accent">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" class="me-1" aria-hidden="true"><path d="M8 1.5A6.5 6.5 0 1 0 8 14.5 6.5 6.5 0 0 0 8 1.5Zm.75 4.25h-1.5v2h-2v1.5h2v2h1.5v-2h2V7.75h-2V5.75Z"/></svg>
            + Create Fish Product
        </a>
    </div>
</div>

@* TempData alerts render once, from Shared/_Alerts.cshtml in the layout. *@

<form method="get" asp-controller="FishProducts" asp-action="Index" class="fish-form-card card shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-6">
                <label for="search" class="form-label">Search</label>
                <input type="text" id="search" name="search" value="@search" class="form-control" placeholder="Search by fish name..." />
            </div>
            <div class="col-12 col-md-4">
                <label for="categoryId" class="form-label">Category</label>
                <select id="categoryId" name="categoryId" class="form-select">
                    <option value="">All categories</option>
                    @foreach (var category in categories)
                    {
                        if (selectedCategory.HasValue && int.Parse(category.Value) == selectedCategory.Value)
                        {
                            <option value="@category.Value" selected="selected">@category.Text</option>
                        }
                        else
                        {
                            <option value="@category.Value">@category.Text</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-fish-primary w-100">Filter</button>
                <a asp-controller="FishProducts" asp-action="Index" class="btn btn-fish-outline">Reset</a>
            </div>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="fish-form-card card shadow-sm rounded-4">
        <div class="card-body text-center p-5">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#9dc4f5" stroke-width="1.2" class="mb-3" aria-hidden="true">
                <path d="M2.5 12c2.6-3.6 5.6-5.4 9-5.4 3.2 0 5.6 1.6 7.1 4.2-1.5 3.6-4.4 5.4-7.7 5.4-3.3 0-6.1-1.4-8.4-4.2Z" />
                <path d="M20.5 18.5c-1.6.9-3.2 1.3-4.8 1.3" />
                <circle cx="16.6" cy="10.4" r=".8" />
            </svg>
            <h5 class="fw-bold text-dark">No fish products yet</h5>
            <p class="text-muted mb-3">Create your first fish product to start building the catalogue.</p>
            <a asp-controller="FishProducts" asp-action="Create" class="btn btn-fish-primary">+ Create Fish Product</a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var product in Model)
        {
            var stockClass = product.Stock == 0 ? "stock-out" : product.Stock <= 5 ? "stock-low" : "stock-in";
            <div class="col-12 col-sm-6 col-lg-3 col-xl-3">
                <div class="fish-card fish-card-hover h-100 d-flex flex-column overflow-hidden">

                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <a asp-controller="FishProducts" asp-action="Details" asp-route-id="@product.ProductId">
                            <img class="fish-product-image" src="@product.ImageUrl" alt="@product.FishName" loading="lazy" />
                        </a>
                    }
                    else
                    {
                        <div class="fish-image-placeholder">
                            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                                <path d="M2.5 12c2.6-3.6 5.6-5.4 9-5.4 3.2 0 5.6 1.6 7.1 4.2-1.5 3.6-4.4 5.4-7.7 5.4-3.3 0-6.1-1.4-8.4-4.2Z" />
                                <path d="M20.5 18.5c-1.6.9-3.2 1.3-4.8 1.3" />
                            </svg>
                            <span>No image</span>
                        </div>
                    }

                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                        <span class="fish-category-chip align-self-start mb-2">@(product.Category?.CategoryName ?? "Uncategorised")</span>
                        <h5 class="fw-bold text-dark mb-1">@product.FishName</h5>

                        <div class="fish-price mb-2">$@product.Price.ToString("0.00")</div>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="stock-badge @stockClass">Stock: @product.Stock</span>
                            <span class="stock-badge stock-in">@product.Weight.ToString("0.00") kg</span>
                        </div>

                        <div class="fish-meta mb-3">
                            Added @product.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                        </div>

                        <div class="mt-auto d-flex gap-2">
                            <a asp-controller="FishProducts" asp-action="Details" asp-route-id="@product.ProductId"
                               class="btn btn-sm btn-fish-primary flex-fill">Details</a>
                            <a asp-controller="FishProducts" asp-action="Edit" asp-route-id="@product.ProductId"
                               class="btn btn-sm btn-fish-outline flex-fill">Edit</a>
                            <a asp-controller="FishProducts" asp-action="Delete" asp-route-id="@product.ProductId"
                               class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
