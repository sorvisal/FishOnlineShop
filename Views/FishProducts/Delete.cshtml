@model FishProduct
@{
    ViewData["Title"] = "Delete Fish Product";
}

<div class="fish-page-header mb-4">
    <h1>Delete Fish Product</h1>
    <p>Are you sure you want to permanently remove this product?</p>
</div>

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="fish-form-card card shadow-sm rounded-4 border-danger-subtle">
            <div class="card-header px-4 py-3 text-danger">Confirm deletion</div>
            <div class="card-body p-4">

                <div class="d-flex gap-3 align-items-center mb-4">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.FishName" class="rounded-3" style="width:110px;height:82px;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="fish-image-placeholder rounded-3" style="width:110px;height:82px;border-radius:12px !important;">
                            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                                <path d="M2.5 12c2.6-3.6 5.6-5.4 9-5.4 3.2 0 5.6 1.6 7.1 4.2-1.5 3.6-4.4 5.4-7.7 5.4-3.3 0-6.1-1.4-8.4-4.2Z" />
                            </svg>
                        </div>
                    }
                    <div>
                        <h5 class="fw-bold text-dark mb-1">@Model.FishName</h5>
                        <div class="fish-meta">@(Model.Category?.CategoryName ?? "Uncategorised") &middot; $@Model.Price.ToString("0.00")</div>
                        <div class="fish-meta">Product ID @Model.ProductId</div>
                    </div>
                </div>

                <div class="alert alert-warning rounded-3 mb-4">
                    This action cannot be undone. The product row and its uploaded image will be removed.
                </div>

                <form asp-controller="FishProducts" asp-action="Delete" asp-route-id="@Model.ProductId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-danger fw-semibold px-4">Yes, delete product</button>
                        <a asp-controller="FishProducts" asp-action="Index" class="btn btn-fish-outline">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
