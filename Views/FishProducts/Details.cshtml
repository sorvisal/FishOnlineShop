@model FishProduct
@{
    ViewData["Title"] = Model.FishName;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="FishProducts" asp-action="Index">Fish Products</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.FishName</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 fw-bold text-dark mb-0">@Model.FishName</h1>
    <div class="d-flex gap-2">
        <a asp-controller="FishProducts" asp-action="Edit" asp-route-id="@Model.ProductId" class="btn btn-fish-outline">Edit</a>
        <a asp-controller="FishProducts" asp-action="Delete" asp-route-id="@Model.ProductId" class="btn btn-outline-danger">Delete</a>
        <a asp-controller="FishProducts" asp-action="Index" class="btn btn-fish-primary">Back to list</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="fish-card shadow-sm overflow-hidden">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img class="fish-details-image" src="@Model.ImageUrl" alt="@Model.FishName" />
            }
            else
            {
                <div class="fish-image-placeholder" style="height:380px;border-radius:0;">
                    <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                        <path d="M2.5 12c2.6-3.6 5.6-5.4 9-5.4 3.2 0 5.6 1.6 7.1 4.2-1.5 3.6-4.4 5.4-7.7 5.4-3.3 0-6.1-1.4-8.4-4.2Z" />
                        <path d="M20.5 18.5c-1.6.9-3.2 1.3-4.8 1.3" />
                    </svg>
                    <span>No image uploaded</span>
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="fish-form-card card shadow-sm rounded-4">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="fish-category-chip">@(Model.Category?.CategoryName ?? "Uncategorised")</span>
                    @{
                        var stockClass = Model.Stock == 0 ? "stock-out" : Model.Stock <= 5 ? "stock-low" : "stock-in";
                    }
                    <span class="stock-badge @stockClass">@(Model.Stock == 0 ? "Out of stock" : $"Stock: {Model.Stock}")</span>
                </div>

                <div class="fish-price display-6 mb-3">$@Model.Price.ToString("0.00")</div>

                <dl class="mb-3">
                    <div class="fish-spec-row">
                        <dt>Product ID</dt>
                        <dd>@Model.ProductId</dd>
                    </div>
                    <div class="fish-spec-row">
                        <dt>Category</dt>
                        <dd>@(Model.Category?.CategoryName ?? "-")</dd>
                    </div>
                    <div class="fish-spec-row">
                        <dt>Weight</dt>
                        <dd>@Model.Weight.ToString("0.00") kg</dd>
                    </div>
                    <div class="fish-spec-row">
                        <dt>Stock</dt>
                        <dd>@Model.Stock</dd>
                    </div>
                    <div class="fish-spec-row">
                        <dt>Image path</dt>
                        <dd><code>@(string.IsNullOrEmpty(Model.ImageUrl) ? "-" : Model.ImageUrl)</code></dd>
                    </div>
                    <div class="fish-spec-row">
                        <dt>Created</dt>
                        <dd>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</dd>
                    </div>
                </dl>

                <h6 class="fw-bold text-dark mt-4">Description</h6>
                <p class="text-muted mb-0" style="white-space:pre-line">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)</p>
            </div>
        </div>
    </div>
</div>
