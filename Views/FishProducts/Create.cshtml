@model FishProductCreateViewModel
@{
    ViewData["Title"] = "Create Fish Product";
}

<div class="fish-page-header mb-4">
    <h1>Create Fish Product</h1>
    <p>Add a new fish to the shop catalogue. Fields marked with * are required.</p>
</div>

@if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
{
    <div class="alert alert-danger rounded-3 shadow-sm" role="alert">
        <strong>Please fix the following before saving:</strong>
        <ul class="mb-0 mt-2">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form asp-controller="FishProducts" asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
    @Html.AntiForgeryToken()
    <div class="row g-4">

        <!-- Left: image upload + preview -->
        <div class="col-12 col-lg-5">
            <div class="fish-form-card card shadow-sm rounded-4 h-100">
                <div class="card-header px-4 py-3">Fish Image</div>
                <div class="card-body p-4">

                    <div class="fish-preview-frame mb-3" id="imagePreview"></div>

                    <div id="uploadZone" class="fish-upload-zone mb-3">
                        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#0d6efd" stroke-width="1.6" class="mb-2" aria-hidden="true">
                            <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M3.5 15v2.5A2.5 2.5 0 0 0 6 20h12a2.5 2.5 0 0 0 2.5-2.5V15" stroke-linecap="round" />
                        </svg>
                        <div class="fw-semibold text-primary">Click to upload or drag &amp; drop</div>
                        <div class="form-text mt-1">Allowed: .jpg, .jpeg, .png, .webp &middot; Max 4 MB</div>
                    </div>

                    <input type="file" id="ImageFile" name="ImageFile"
                           class="form-control d-none"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <label asp-for="ImageFile" class="form-label d-none">Fish Image</label>

                    <div id="imageInfo" class="form-text mb-2"></div>
                    <div id="imageClientError" class="invalid-feedback d-block"></div>
                    <span asp-validation-for="ImageFile" class="text-danger small"></span>

                    <div class="alert alert-light border rounded-3 mt-3 mb-0 small text-muted">
                        Images are stored on the server under <code>wwwroot/images/fish/</code> and only the
                        relative path is saved to SQL Server.
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: product fields -->
        <div class="col-12 col-lg-7">
            <div class="fish-form-card card shadow-sm rounded-4">
                <div class="card-header px-4 py-3">Product Information</div>
                <div class="card-body p-4">

                    <div class="mb-3">
                        <label asp-for="FishName" class="form-label">Fish Name <span class="text-danger">*</span></label>
                        <input asp-for="FishName" class="form-control" placeholder="e.g. Red Moon Goldfish" />
                        <span asp-validation-for="FishName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="CategoryId" class="form-label">Category <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        <div class="form-text">Categories are loaded from the Categories table.</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label asp-for="Price" class="form-label">Price ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Price" class="form-control" step="0.01" min="0.01" placeholder="79.00" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <div class="col-12 col-md-6">
                            <label asp-for="Stock" class="form-label">Stock Quantity <span class="text-danger">*</span></label>
                            <input asp-for="Stock" class="form-control" min="0" step="1" placeholder="20" />
                            <span asp-validation-for="Stock" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-3 mb-3">
                        <label asp-for="Weight" class="form-label">Weight (kg) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input asp-for="Weight" class="form-control" step="0.01" min="0.01" placeholder="0.50" />
                            <span class="input-group-text">kg</span>
                        </div>
                        <span asp-validation-for="Weight" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Care level, temperament, tank size, water temperature..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                        <button type="submit" class="btn btn-fish-primary">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" class="me-1" aria-hidden="true"><path d="M8 1.5A6.5 6.5 0 1 0 8 14.5 6.5 6.5 0 0 0 8 1.5Zm.75 4.25h-1.5v2h-2v1.5h2v2h1.5v-2h2V7.75h-2V5.75Z"/></svg>
                            Create Product
                        </button>
                        <a asp-controller="FishProducts" asp-action="Index" class="btn btn-fish-outline">Cancel</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
