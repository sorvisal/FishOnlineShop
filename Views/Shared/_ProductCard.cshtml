@model ProductCardViewModel
@{
    var product = Model.Product;
    var outOfStock = product.Stock <= 0;
    var routeValues = new Dictionary<string, string?>(Model.RouteValues, StringComparer.OrdinalIgnoreCase)
    {
        ["id"] = product.ProductId.ToString()
    };
}

<div class="@Model.ColumnClass">
    <article class="aq-product-card">
        <div class="aq-product-media">
            <div class="aq-product-flags">
                @if (outOfStock)
                {
                    <span class="aq-badge aq-badge-out">Out of stock</span>
                }
                else if (product.Stock <= 5)
                {
                    <span class="aq-badge aq-badge-warn">Only @product.Stock left</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
            {
                <img class="aq-product-img" src="@product.ImageUrl" alt="@product.FishName" loading="lazy" />
            }
            else
            {
                <div class="aq-product-media-empty">
                    <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                        <path d="M2.5 12c2.6-3.6 5.6-5.4 9-5.4 3.2 0 5.6 1.6 7.1 4.2-1.5 3.6-4.4 5.4-7.7 5.4-3.3 0-6.1-1.4-8.4-4.2Z" />
                        <path d="M20.5 18.5c-1.6.9-3.2 1.3-4.8 1.3" stroke-linecap="round" />
                    </svg>
                    <span>No image</span>
                </div>
            }
        </div>

        <div class="aq-product-body">
            <span class="aq-product-cat">@(product.Category?.CategoryName ?? "Uncategorised")</span>

            <a class="aq-product-link" asp-controller="@Model.ControllerName" asp-action="@Model.ActionName"
               asp-all-route-data="@routeValues">@product.FishName</a>

            @if (!string.IsNullOrWhiteSpace(product.Description))
            {
                <p class="aq-product-desc">@product.Description</p>
            }

            <div class="aq-price">$@product.Price.ToString("0.00")</div>

            <div class="aq-product-meta">
                <span class="aq-badge @(outOfStock ? "aq-badge-out" : product.Stock <= 5 ? "aq-badge-warn" : "aq-badge-in")">
                    @(outOfStock ? "Out of stock" : $"In stock: {product.Stock}")
                </span>
                <span class="aq-badge aq-badge-mute">@product.Weight.ToString("0.00") kg</span>
            </div>

            <div class="aq-product-actions">
                @if (outOfStock)
                {
                    <button type="button" class="aq-btn aq-btn-ghost aq-btn-sm aq-btn-block" disabled>Out of stock</button>
                }
                else
                {
                    <a class="aq-btn aq-btn-orange aq-btn-sm aq-btn-block"
                       asp-controller="@Model.ControllerName" asp-action="@Model.ActionName"
                       asp-all-route-data="@routeValues">@Model.ActionLabel</a>
                }

                @if (Model.ShowAdminActions)
                {
                    <a class="aq-btn aq-btn-soft aq-btn-sm" asp-controller="FishProducts" asp-action="Edit"
                       asp-route-id="@product.ProductId">Edit</a>
                    <a class="aq-btn aq-btn-ghost aq-btn-sm aq-btn-danger-ghost" asp-controller="FishProducts" asp-action="Delete"
                       asp-route-id="@product.ProductId">Delete</a>
                }
            </div>
        </div>
    </article>
</div>