@using System.Security.Claims
@inject ICartSession CartSession
@{
    var currentController = ViewContext.RouteData.Values["controller"] as string ?? string.Empty;
    var cartCount = CartSession.GetItemCount();

    // Nav state is resolved here because Razor does not evaluate expressions with
    // parentheses inside a tag helper attribute value.
    string Active(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? " active" : string.Empty;

    var homeActive = Active("Home");
    var shopActive = Active("Shop");
    var aboutActive = Active("About");
    var contactActive = Active("Contact");

    // Auth state for the navbar. Role claims come from the cookie, populated by
    // UseAuthentication which runs before UseAuthorization.
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = User.IsInRole(UserRoles.Admin);
    var displayName = User.FindFirst(ClaimTypes.Name)?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FishOnlineShop</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/aquafy.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FishOnlineShop.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="aq-skip-link" href="#main-content">Skip to main content</a>

    <header>
        <div class="aq-topbar d-none d-md-block">
            <div class="container">
                <div class="d-flex flex-wrap justify-content-between align-items-center py-2 gap-3">
                    <div class="d-flex flex-wrap gap-4">
                        <span class="aq-topbar-item">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M12 21s-7-5.5-7-11a7 7 0 1 1 14 0c0 5.5-7 11-7 11Z" stroke-linejoin="round" />
                                <circle cx="12" cy="10" r="2.5" />
                            </svg>
                            128 River Lane, Marina Bay
                        </span>
                        <a class="aq-topbar-item" href="tel:+15550142200">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M4 5c0-1 .8-2 2-2h2l2 5-2.5 1.5a13 13 0 0 0 6 6L15 13l5 2v2c0 1.2-1 2-2 2A15 15 0 0 1 4 5Z" stroke-linejoin="round" />
                            </svg>
                            +1 (555) 014-2200
                        </a>
                    </div>
                    <div class="d-flex flex-wrap gap-4">
                        <span class="aq-topbar-item">Free delivery over $99</span>
                        <span class="aq-topbar-item">Open daily 9:00 - 20:00</span>
                    </div>
                </div>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg aq-navbar py-2" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand aq-brand" asp-controller="Home" asp-action="Index">
                    <span class="aq-brand-mark">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M2.5 12c2.6-3.6 5.6-5.4 9-5.4 3.2 0 5.6 1.6 7.1 4.2-1.5 3.6-4.4 5.4-7.7 5.4-3.3 0-6.1-1.4-8.4-4.2Z" />
                            <path d="M20.5 18.5c-1.6.9-3.2 1.3-4.8 1.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        </svg>
                    </span>
                    <span class="aq-brand-text">
                        FishOnlineShop
                        <small>Aquarium &amp; Fish</small>
                    </span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#aqMainNav" aria-controls="aqMainNav" aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="aqMainNav">
                    <ul class="navbar-nav ms-lg-4 me-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link aq-nav-link@(homeActive)" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link aq-nav-link@(shopActive)" asp-controller="Shop" asp-action="Index">Shop</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link aq-nav-link@(aboutActive)" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link aq-nav-link@(contactActive)" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                    </ul>

                    <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2 gap-lg-3 py-3 py-lg-0">
                        <form class="aq-search" asp-controller="Shop" asp-action="Index" method="get" role="search">
                            <label class="aq-sr-only" for="aqNavSearch">Search fish products</label>
                            <span class="aq-search-icon" aria-hidden="true">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                                    <circle cx="11" cy="11" r="7" />
                                    <path d="m20 20-3.5-3.5" stroke-linecap="round" />
                                </svg>
                            </span>
                            <input class="form-control" type="search" id="aqNavSearch" name="search"
                                   placeholder="Search fish, food, tanks..." />
                        </form>

                        <div class="d-flex align-items-center justify-content-between justify-content-lg-end gap-2">
                            <a class="aq-cart" asp-controller="Cart" asp-action="Index" aria-label="Shopping cart">
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.5a2 2 0 0 0 2-1.5L20.5 8H6" stroke-linecap="round" stroke-linejoin="round" />
                                    <circle cx="10" cy="20" r="1.4" />
                                    <circle cx="17.5" cy="20" r="1.4" />
                                </svg>
                                @if (cartCount > 0)
                                {
                                    <span class="aq-cart-badge">@cartCount</span>
                                }
                            </a>

                            @if (!isSignedIn)
                            {
                                <a class="aq-btn aq-btn-ghost aq-btn-sm" asp-controller="Account" asp-action="Login">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <circle cx="12" cy="8" r="4" />
                                        <path d="M4.5 20a7.5 7.5 0 0 1 15 0" stroke-linecap="round" />
                                    </svg>
                                    Sign in
                                </a>

                                <a class="aq-btn aq-btn-orange aq-btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                            }
                            else
                            {
                                <div class="dropdown">
                                    <button class="aq-btn aq-btn-ghost aq-btn-sm dropdown-toggle" type="button"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <circle cx="12" cy="8" r="4" />
                                            <path d="M4.5 20a7.5 7.5 0 0 1 15 0" stroke-linecap="round" />
                                        </svg>
                                        <span class="text-truncate" style="max-width: 120px;">@displayName</span>
                                        @if (isAdmin)
                                        {
                                            <span class="aq-badge aq-badge-blue">Admin</span>
                                        }
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="Orders">My Orders</a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="dropdown-item">Log out</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            }

                            @if (isAdmin)
                            {
                                <a class="aq-btn aq-btn-ghost aq-btn-sm" asp-controller="FishProducts" asp-action="Index">
                                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                        <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.5a2 2 0 0 0 2-1.5L20.5 8H6" stroke-linecap="round" stroke-linejoin="round" />
                                        <circle cx="10" cy="20" r="1.4" />
                                        <circle cx="17.5" cy="20" r="1.4" />
                                    </svg>
                                    Manage Products
                                </a>

                                <a class="aq-btn aq-btn-orange aq-btn-sm" asp-controller="FishProducts" asp-action="Create">
                                    <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                        <path d="M8 1.5A6.5 6.5 0 1 0 8 14.5 6.5 6.5 0 0 0 8 1.5Zm.75 4.25h-1.5v2h-2v1.5h2v2h1.5v-2h2V7.75h-2V5.75Z" />
                                    </svg>
                                    Create Fish Product
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" role="main">
        <div class="container">
            <partial name="_Alerts" />
            @RenderBody()
        </div>
    </main>

    <partial name="_Footer" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>