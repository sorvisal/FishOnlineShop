@inject FishOnlineShop.Data.ApplicationDbContext Db
@{
    var footerCategories = await Db.Categories
        .AsNoTracking()
        .OrderBy(c => c.CategoryName)
        .Take(6)
        .ToListAsync();
}

<footer class="aq-footer">
    <div class="container">
        <div class="row g-4 g-lg-5">
            <div class="col-12 col-lg-4">
                <a class="aq-brand" asp-controller="Home" asp-action="Index">
                    <span class="aq-brand-mark">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M2.5 12c2.6-3.6 5.6-5.4 9-5.4 3.2 0 5.6 1.6 7.1 4.2-1.5 3.6-4.4 5.4-7.7 5.4-3.3 0-6.1-1.4-8.4-4.2Z" />
                            <path d="M20.5 18.5c-1.6.9-3.2 1.3-4.8 1.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        </svg>
                    </span>
                    <span class="aq-brand-text">
                        FishOnlineShop
                        <small>Aquarium &amp; Fish</small>
                    </span>
                </a>

                <p class="aq-footer-about">
                    Family run aquarium specialists since 2009. Healthy live fish, responsible stock
                    and honest care advice, delivered to your door.
                </p>

                <div class="aq-footer-social">
                    <a href="#" aria-label="FishOnlineShop on Facebook">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.2 0-1-.1-1.9-.1-1.9 0-3.2 1.1-3.2 3.2V11H8.8v3h2.5v7h2.2Z" />
                        </svg>
                    </a>
                    <a href="#" aria-label="FishOnlineShop on Instagram">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                            <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
                            <circle cx="12" cy="12" r="3.8" />
                            <circle cx="17" cy="7" r="1" fill="currentColor" stroke="none" />
                        </svg>
                    </a>
                    <a href="#" aria-label="FishOnlineShop on X">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M17.6 4h2.9l-6.3 7.2L21.6 20h-5.9l-4.6-5.5L5.8 20H2.9l6.7-7.7L2.4 4h6l4.2 5 5-5Zm-1 14.3h1.6L7.5 5.6H5.8l10.8 12.7Z" />
                        </svg>
                    </a>
                </div>
            </div>

            <div class="col-6 col-lg-2">
                <h3>Overview</h3>
                <ul class="aq-footer-links">
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="Shop" asp-action="Index">Shop</a></li>
                    <li><a asp-controller="Cart" asp-action="Index">Cart</a></li>
                    <li><a asp-controller="Account" asp-action="Orders">My Orders</a></li>
                    <li><a asp-controller="Home" asp-action="About">About us</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Contact</a></li>
                </ul>
            </div>

            <div class="col-6 col-lg-2">
                <h3>Category</h3>
                <ul class="aq-footer-links">
                    @foreach (var category in footerCategories)
                    {
                        <li>
                            <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@category.CategoryId">@category.CategoryName</a>
                        </li>
                    }
                </ul>
            </div>

            <div class="col-6 col-lg-2">
                <h3>Policy</h3>
                <ul class="aq-footer-links">
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy policy</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy" asp-fragment="shipping">Shipping &amp; returns</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy" asp-fragment="live-animals">Live animal guarantee</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Support</a></li>
                </ul>
            </div>

            <div class="col-12 col-lg-2">
                <div class="aq-newsletter">
                    <h3 class="aq-newsletter-title">Stay in the loop</h3>
                    <p class="mb-3" style="color: rgba(255,255,255,.6); font-size:.86rem;">
                        New arrivals and care guides, once a month.
                    </p>
                    <form asp-controller="Home" asp-action="Newsletter" method="post" class="d-flex flex-column gap-2">
                        @Html.AntiForgeryToken()
                        <label class="aq-sr-only" for="aqNewsletterEmail">Email address</label>
                        <input class="form-control" type="email" id="aqNewsletterEmail" name="email"
                               placeholder="you@example.com" required />
                        <button type="submit" class="aq-btn aq-btn-orange aq-btn-sm aq-btn-block">Subscribe</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="aq-footer-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
            <span>&copy; @DateTime.UtcNow.Year FishOnlineShop. All rights reserved.</span>
            <div class="aq-footer-payments">
                <span>Cash on delivery</span>
                <span>Bank transfer</span>
                <span>Card on request</span>
            </div>
        </div>
    </div>
</footer>