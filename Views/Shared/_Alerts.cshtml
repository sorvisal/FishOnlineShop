@{
    var success = TempData["SuccessMessage"] as string;
    var error = TempData["ErrorMessage"] as string;
    var warning = TempData["WarningMessage"] as string;
}

@if (!string.IsNullOrWhiteSpace(success))
{
    <div class="aq-alert aq-alert-success" role="status">
        <svg width="19" height="19" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M6.3 11.7 3 8.4l1.1-1.1 2.2 2.2 5.6-5.6L13 5Z" />
        </svg>
        <span>@success</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(warning))
{
    <div class="aq-alert aq-alert-warn" role="alert">
        <svg width="19" height="19" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1.5 15 14H1L8 1.5Zm0 4.2a.8.8 0 0 0-.8.85l.2 3a.6.6 0 0 0 1.2 0l.2-3A.8.8 0 0 0 8 5.7Zm0 6.1a.85.85 0 1 0 0-1.7.85.85 0 0 0 0 1.7Z" />
        </svg>
        <span>@warning</span>
    </div>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="aq-alert aq-alert-danger" role="alert">
        <svg width="19" height="19" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1.5 15 14H1L8 1.5Zm0 4.2a.8.8 0 0 0-.8.85l.2 3a.6.6 0 0 0 1.2 0l.2-3A.8.8 0 0 0 8 5.7Zm0 6.1a.85.85 0 1 0 0-1.7.85.85 0 0 0 0 1.7Z" />
        </svg>
        <span>@error</span>
    </div>
}