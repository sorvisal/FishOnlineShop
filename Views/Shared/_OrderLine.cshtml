@model OrderLineViewModel
@* Renders one order line from plain values only. No navigation properties are touched here,
   so a product row that was not loaded still renders. *@

<div class="d-flex align-items-center gap-3 py-3 border-bottom">
    <div class="aq-line-thumb @(Model.HasImage ? string.Empty : "aq-line-thumb-empty")">
        @if (Model.HasImage)
        {
            <img src="@Model.ImageUrl" alt="@Model.ProductName" loading="lazy" />
        }
        else
        {
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.4" aria-hidden="true">
                <path d="M2.5 12c2.6-3.6 5.6-5.4 9-5.4 3.2 0 5.6 1.6 7.1 4.2-1.5 3.6-4.4 5.4-7.7 5.4-3.3 0-6.1-1.4-8.4-4.2Z" />
                <path d="M20.5 18.5c-1.6.9-3.2 1.3-4.8 1.3" stroke-linecap="round" />
            </svg>
            <span>No image</span>
        }
    </div>

    <div class="flex-grow-1 aq-min-w-0">
        <span class="fw-semibold d-block text-truncate">@Model.ProductName</span>
        <span class="small" style="color: var(--aq-muted);">
            &times; @Model.Quantity at @Model.UnitPrice.ToString("C")
        </span>
    </div>

    <span class="fw-semibold text-nowrap">@Model.SubTotal.ToString("C")</span>
</div>