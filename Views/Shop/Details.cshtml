@model ShopDetailsViewModel
@{
    ViewData["Title"] = Model.Product.FishName;
    var product = Model.Product;

    var isAdmin = User.IsInRole(UserRoles.Admin);

    ProductCardViewModel Card(FishProduct related)
        => new()
        {
            Product = related,
            ColumnClass = "col-12 col-6 col-lg-3",
            ActionLabel = "View fish",
            ShowAdminActions = isAdmin
        };
}

<partial name="_Breadcrumb" model="Model.Breadcrumb" />

<div class="row g-4 g-lg-5">
    @* ---------------- Gallery ---------------- *@
    <div class="col-12 col-lg-5">
        <div class="aq-product-media" style="height: 420px; border-radius: var(--aq-radius);">
            @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
            {
                <img class="aq-product-img" src="@product.ImageUrl" alt="@product.FishName" />
            }
            else
            {
                <div class="aq-product-media-empty">
                    <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
                        <path d="M2.5 12c2.6-3.6 5.6-5.4 9-5.4 3.2 0 5.6 1.6 7.1 4.2-1.5 3.6-4.4 5.4-7.7 5.4-3.3 0-6.1-1.4-8.4-4.2Z" />
                        <path d="M20.5 18.5c-1.6.9-3.2 1.3-4.8 1.3" stroke-linecap="round" />
                    </svg>
                    <span>No image uploaded</span>
                </div>
            }
        </div>
    </div>

    @* ---------------- Buy box ---------------- *@
    <div class="col-12 col-lg-7">
        <span class="aq-product-cat">@product.Category?.CategoryName</span>
        <h1 class="mb-2" style="font-size: clamp(1.6rem, 3vw, 2.1rem);">@product.FishName</h1>

        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <span class="aq-badge @Model.StockBadgeClass">@Model.StockLabel</span>
            <span class="aq-badge aq-badge-mute">Weight @product.Weight.ToString("0.00") kg</span>
            <span class="aq-badge aq-badge-mute">SKU @product.ProductId.ToString("D5")</span>
        </div>

        <div class="aq-price mb-4" style="font-size: 1.9rem;">$@product.Price.ToString("0.00")</div>

        <form asp-controller="Cart" asp-action="Add" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@product.ProductId" />

            <div class="row g-3 align-items-end mb-4">
                <div class="col-12 col-sm-auto">
                    <label class="aq-label" for="quantity">Quantity</label>
                    <div class="aq-qty">
                        <button type="button" data-aq-qty-step="-1" aria-label="Decrease quantity">&minus;</button>
                        <input type="number" id="quantity" name="quantity" value="1"
                               min="1" max="@Model.MaxQuantity" step="1" />
                        <button type="button" data-aq-qty-step="1" aria-label="Increase quantity">+</button>
                    </div>
                </div>

                <div class="col-12 col-sm">
                    @if (Model.IsOutOfStock)
                    {
                        <button type="button" class="aq-btn aq-btn-ghost aq-btn-lg aq-btn-block" disabled>
                            Out of stock
                        </button>
                    }
                    else
                    {
                        <button type="submit" class="aq-btn aq-btn-orange aq-btn-lg aq-btn-block">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.5a2 2 0 0 0 2-1.5L20.5 8H6" stroke-linecap="round" stroke-linejoin="round" />
                                <circle cx="10" cy="20" r="1.4" />
                                <circle cx="17.5" cy="20" r="1.4" />
                            </svg>
                            Add to Cart
                        </button>
                    }
                </div>
            </div>
        </form>

        <div class="aq-panel p-3 p-lg-4">
            <h2 class="aq-panel-title mb-3">Product details</h2>
            <dl class="mb-0">
                <div class="aq-summary-row">
                    <dt>Category</dt>
                    <dd>@(product.Category?.CategoryName ?? "-")</dd>
                </div>
                <div class="aq-summary-row">
                    <dt>Weight</dt>
                    <dd>@product.Weight.ToString("0.00") kg</dd>
                </div>
                <div class="aq-summary-row">
                    <dt>Availability</dt>
                    <dd>@Model.StockLabel</dd>
                </div>
                <div class="aq-summary-row">
                    <dt>Added</dt>
                    <dd>@product.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</dd>
                </div>
            </dl>

            <h3 class="aq-panel-title mt-4 mb-2">Description</h3>
            <p class="mb-0" style="white-space: pre-line; color: var(--aq-ink-soft);">
                @(string.IsNullOrWhiteSpace(product.Description) ? "No description provided for this product yet." : product.Description)
            </p>
        </div>
    </div>
</div>

@* ---------------- Related ---------------- *@
@if (Model.RelatedProducts.Count > 0)
{
    <section class="aq-section">
        <div class="aq-section-head">
            <div>
                <span class="aq-eyebrow">You may also like</span>
                <h2 class="aq-section-title">More from @(product.Category?.CategoryName ?? "this category")</h2>
            </div>
            <a class="aq-link-more" asp-controller="Shop" asp-action="Index"
               asp-route-categoryId="@product.CategoryId">View all</a>
        </div>

        <div class="row g-3 g-lg-4">
            @foreach (var related in Model.RelatedProducts)
            {
                <partial name="_ProductCard" model="@Card(related)" />
            }
        </div>
    </section>
}

@section Scripts {
    <script>
        // Quantity stepper. Works without JS: the field is a plain number input with
        // min/max, the buttons are only a convenience.
        (function () {
            var input = document.getElementById('quantity');
            if (!input) {
                return;
            }

            var min = parseInt(input.min, 10) || 1;
            var max = parseInt(input.max, 10) || 99;

            Array.prototype.forEach.call(document.querySelectorAll('[data-aq-qty-step]'), function (button) {
                button.addEventListener('click', function () {
                    var step = parseInt(button.getAttribute('data-aq-qty-step'), 10) || 0;
                    var next = (parseInt(input.value, 10) || min) + step;
                    if (next < min) { next = min; }
                    if (next > max) { next = max; }
                    input.value = next;
                });
            });
        })();
    </script>
}